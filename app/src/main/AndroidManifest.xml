<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LAN discovery (NSD / mDNS) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi Direct (WifiDirectManager) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 13+ (API 33+): replaces location as the runtime gate for
         Wi-Fi Direct/nearby-device discovery. "neverForLocation" is
         accurate here — this app never derives physical location from
         peer scan results, only device identity. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- Android 12/12L (API 31-32, the bottom of this app's minSdk)
         predate NEARBY_WIFI_DEVICES; Wi-Fi Direct peer discovery there
         still needs fine location instead. Dropped automatically on 33+
         by maxSdkVersion. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- Not required: devices without Wi-Fi Direct hardware just see
         WifiDirectManager no-op (same pattern as the Bluetooth adapter
         null-check elsewhere in this app). -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!-- Bluetooth discovery (Android 12+ runtime-permission model) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Foreground service that keeps the continuity link alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LwosConnect"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Second Screen (wired, mirror mode). Its own Activity rather
          than a dialog/fragment inside MainActivity because it needs a
          real fullscreen Surface for MediaCodec to decode straight
          onto, and its own lifecycle (start/stop the decoder with the
          screen, not with the main app window).
        -->
        <activity
            android:name=".ui.SecondScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout"
            android:screenOrientation="userLandscape"
            android:theme="@style/Theme.LwosConnect" />

        <activity
            android:name=".ui.ShortcutsActivity"
            android:exported="false"
            android:theme="@style/Theme.LwosConnect" />

        <service
            android:name=".service.ContinuityService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Notification mirroring. BIND_NOTIFICATION_LISTENER_SERVICE can
          only be granted by the user manually, via the system settings
          screen ContinuityService.openNotificationAccessSettings() deep
          links to — there's no runtime permission dialog for this one.
        -->
        <service
            android:name=".service.NotificationMirrorListenerService"
            android:exported="false"
            android:label="LWOS Notification Mirror"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
